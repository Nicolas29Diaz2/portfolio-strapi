{
  "kind": "collectionType",
  "collectionName": "skills",
  "info": {
    "singularName": "skill",
    "pluralName": "skills",
    "displayName": "Skill"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "type": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "web",
        "tool",
        "design"
      ]
    },
    "skillPoints": {
      "type": "integer",
      "min": 1,
      "max": 4
    },
    "yPosition": {
      "type": "integer",
      "default": 50
    }
  }
}
